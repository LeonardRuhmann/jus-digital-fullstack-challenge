# =============================================================================
# Jus Digital - FullStack Challenge Environment Variables Template
# Copy this file to `.env` and fill in your credentials.
# NEVER commit your `.env` file to Git.
# =============================================================================

# --- Application & URLs ---
APP_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:8000

# --- Security / Session JWT ---
# Generate a strong secret with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-local-env-with-a-long-random-secret-key
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# --- Database (PostgreSQL) ---
POSTGRES_USER=jusdigital
POSTGRES_PASSWORD=jusdigital_dev_pass
POSTGRES_DB=jusdigital_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://jusdigital:jusdigital_dev_pass@localhost:5432/jusdigital_db

# --- Google OAuth 2.0 (Google Cloud Console) ---
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# --- AWS S3 (File Storage) ---
AWS_REGION=sa-east-1
AWS_S3_BUCKET_NAME=jus-digital-docs-yourname-2026
AWS_ACCESS_KEY_ID=your-aws-iam-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-iam-secret-access-key
AWS_PRESIGNED_URL_EXPIRATION=900

# --- OpenAI API (Provided by Jus Digital) ---
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_MODEL=gpt-4o-mini
